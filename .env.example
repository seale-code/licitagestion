# Copy to .env; Spring imports this file as properties (no quotes around values).
SPRING_PROFILES_ACTIVE=postgres
DB_URL=jdbc:postgresql://localhost:5432/licitagestion?currentSchema=licitagestion_private
DB_USER=licitagestion
DB_PASSWORD=change-local-db-password
APP_PORT=8080
APP_ZONE=America/Lima
APP_STORAGE=./data/private-documents
# Initial administrator, used only when the users table is empty.
BOOTSTRAP_EMAIL=admin@example.com
BOOTSTRAP_PASSWORD=change-this-to-a-strong-password
COOKIE_SECURE=false
REQUIRE_HTTPS=false
# Comma-separated literal addresses of reverse proxies allowed to set X-Forwarded-For.
TRUSTED_PROXY_ADDRESSES=
# Enable only for local demos. Disabled for postgres by default.
DEMO_SEED=false
# extractive = offline rules, llm = configured chat-completions adapter
AI_MODE=extractive
LLM_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=
# External transfer of private documents must be enabled deliberately.
LLM_DOCUMENT_TRANSFER_ENABLED=false
# dry-run never contacts Meta. cloud uses the official API after an admin approves a send.
WHATSAPP_MODE=dry-run
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=es

